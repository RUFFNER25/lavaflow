# Base de datos SQLite (sin Docker ni Postgres)
DATABASE_URL="file:../data/lavanderia.db"

APP_URL=http://localhost:3000
AUTH_SECRET=cambia_por_una_cadena_aleatoria_de_al_menos_32_chars
INTERNAL_API_KEY=cambia_clave_interna_servicios

# API DNI — https://apifacturacion.com/
DNI_API_URL=https://api.apifacturacion.com/dni/{dni}
DNI_API_TOKEN=TU_TOKEN_AQUI
DNI_DEMO_MODE=false

# WhatsApp (Baileys) — proceso aparte: npm run dev:wa
WA_SESSION_NAME=tenant-demo-lavanderia
WA_POLL_MS=5000
WA_AUTH_DIR=./whatsapp/auth/tenant-demo-lavanderia
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
