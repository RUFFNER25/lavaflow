{
  "name": "sistema-lavanderia",
  "private": true,
  "scripts": {
    "setup": "npm --prefix web install && npm --prefix whatsapp install && npm run db:migrate && npm run db:seed",
    "dev": "npm --prefix web run dev",
    "dev:wa": "npm --prefix whatsapp run start",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "db:migrate": "npm --prefix web run db:migrate",
    "db:seed": "npm --prefix web run db:seed",
    "db:studio": "npm --prefix web run db:studio",
    "backup": "sh scripts/backup.sh"
  }
}
